# Solvo public web-chat channel (both values are public by design: Solvo's own
# widget exposes the key in a <script> tag). Put the real values in
# .env.production (committed) so the GitHub Pages build picks them up.
# Without them the guide runs in offline mode.
#
# Origin of the Solvo API (a trailing /api is tolerated).
NEXT_PUBLIC_SOLVO_API_URL=https://api.example.com
# Chat key of the "web" channel, from the Solvo panel: wpk_ + 32 hex chars.
NEXT_PUBLIC_SOLVO_CHAT_KEY=wpk_00000000000000000000000000000000
